# =============================================================================
# Production environment for the AMR Resilience API
# Copy to the runtime secret store (Cloud Run env / Secret Manager) — do NOT
# commit real values.
# =============================================================================

# --- GCP ---
GCP_PROJECT="patchamomma-2026-505909"
GCP_LOCATION="us-central1"
BQ_DATASET_ID="amr_resilience"

# --- Auth / security (REQUIRED) ---
# Long random string. Rotating it invalidates every issued session token.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET="__CHANGE_ME__"
# Must stay false in production — only bearer tokens are trusted.
ALLOW_HEADER_AUTH="false"
# Shared key for the HIS/LIS machine webhook (POST /ingestion/hospital/webhook).
HOSPITAL_INGEST_KEY="__CHANGE_ME__"

# --- Storage ---
GCS_RAW_BUCKET="amr-raw-data-patchamomma-2026"
GCS_VENDOR_BUCKET="amr-vendor-docs-patchamomma-2026"
GCS_HOSPITAL_BUCKET="amr-hospital-staging-patchamomma-2026"

# --- Optional integrations ---
# Vendor approval notifications are POSTed here on every state transition.
VENDOR_WEBHOOK_URL=""
# Google Document AI processor for vendor doc extraction. When unset the
# heuristic regex extractor is used.
#   projects/<n>/locations/<loc>/processors/<id>
DOC_AI_PROCESSOR=""

# --- LLM (investigation agent, optional) ---
GEMINI_API_KEY=""
